# Copy this file and fill in your key. The copy is gitignored and must never
# be committed. Nothing in THIS file is a real credential - it documents
# variable NAMES only.
#
#   cp .env.example .env     # then edit and paste your key
#
# Or skip the file entirely and export the key in your shell:
#
#   export OPENAI_API_KEY=sk-...

# --- Required: your OpenAI secret key ---
# Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# --- Optional: model ---
OPENAI_MODEL=gpt-4o-mini

# --- Optional: endpoint ---
# Any OpenAI-compatible chat-completions endpoint works: Azure OpenAI, vLLM,
# LiteLLM, OpenRouter, Ollama, or a self-hosted gateway. It MUST return a
# `usage` block on each completion - per-call token accounting is the whole
# point of this experiment, and an endpoint that omits it zeroes every cost
# column. The runner's preflight warns you if it does.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Optional: TLS, for a network that intercepts HTTPS ---
# OPENAI_CA_BUNDLE=/path/to/ca-bundle.pem
# OPENAI_VERIFY_SSL=true
