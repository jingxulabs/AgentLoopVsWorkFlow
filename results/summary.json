      "flaky_tools": {
        "description": "30% of tool calls return a transient 503.",
        "hypothesis": "A retry is already in the loop's vocabulary - a failed call is just another observation. The DAG has no retry edge, so a failed hop becomes a permanent hole in the synthesis context. Expect the accuracy gap to open up here."
      },
      "hop_mismatch": {
        "description": "Comparison questions mixed in with bridge questions.",
        "hypothesis": "Comparison questions need two independent lookups, not a bridge. The DAG's hop-2 query is conditioned on hop-1 output that is irrelevant here, so it should degrade. The loop discovers the shape; the router should recover most of the gap at the cost of one extra call."
      },
      "distractor_heavy": {
